{
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 429],
  "ignorePatterns": [
    {
      "pattern": "https://github.com/?.*"
    },
    {
      "pattern": "https://platform.openai.com/docs/.*"
    },
    {
      "pattern": ".*localhost.*"
    },
    {
      "pattern": "https://join.slack.com/.*"
    },
    {
      "pattern": "^(?!https).*(?<!\\.md)$"
    }
  ]
}
